# ======================================================================
# Fact-Kard Core en Docker — deploy/docker/.env de PRODUCCIÓN (VPS)
#
#   cd deploy/docker && cp env.produccion.example .env && chmod 600 .env
#
# Reemplaza todo lo marcado <...>. NUNCA subas .env a Git (ya está en .gitignore).
# Lo leen Docker Compose (variables ${...}) y el contenedor backend (env_file).
# Las rutas internas, DB_HOST y CACHE_URL las fija compose.yaml: no se configuran aquí.
# Sin comillas alrededor de los valores.
# ======================================================================

# --- Dominio (el mismo que se agrega a SITIOS en el proxy) -------------
ALLOWED_HOSTS=<kardex.asescon.net>
CORS_ALLOWED_ORIGINS=https://<kardex.asescon.net>
CSRF_TRUSTED_ORIGINS=https://<kardex.asescon.net>

# --- Seguridad --------------------------------------------------------
DEBUG=False
# python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=<clave aleatoria de 50+ caracteres>

# --- HTTPS detrás de DOS proxies: proxy compartido → Nginx web → Gunicorn ---
SECURE_PROXY_SSL_HEADER_HTTPS=True
NUM_PROXIES=2
SECURE_SSL_REDIRECT=True
# Empezar con 3600 (1 h); subir a 31536000 cuando HTTPS lleve unos días estable.
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=True

# --- Sesión -----------------------------------------------------------
TOKEN_MAX_AGE_SECONDS=43200
LOGIN_THROTTLE_RATE=10/min
AUTH_COOKIE_ENABLED=False
CACHE_KEY_PREFIX=fact-kard-core

# --- PostgreSQL (contenedor db; la contraseña la usan db y backend) ----
# Base PROPIA de este sistema (no es la de FACT-KARD).
DB_NAME=fact_kard_core
DB_USER=fact_kard_core_user
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DB_PASSWORD=<contraseña larga y aleatoria>
DB_CONN_MAX_AGE=60

# --- Logs, API y admin --------------------------------------------------
LOG_LEVEL=INFO
API_DOCS_ENABLED=False
DJANGO_ADMIN_ENABLED=False

# --- Gunicorn (4 vCPU compartidas con otros dos sistemas: 2 workers) -----
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120

# --- Respaldos (manage.py respaldo; ver docs/DESPLIEGUE_DOCKER.md) --------
FACT_KARD_BACKUP_EXTERNAL_PATH=
FACT_KARD_BACKUP_RETENCION_DIARIOS=7
FACT_KARD_BACKUP_RETENCION_SEMANALES=4
FACT_KARD_BACKUP_RETENCION_MENSUALES=6
# Hora del respaldo automático diario (servicio tareas), hora de Lima. Por defecto 04:00.
# FK_RESPALDO_HORA=04:00

# --- Carpeta del servidor para los respaldos (opcional) -------------------
# Por defecto: deploy/docker/datos/respaldos.
# FK_DIR_RESPALDOS=/srv/fact-kard-core/respaldos
