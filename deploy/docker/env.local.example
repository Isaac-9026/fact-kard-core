# ======================================================================
# Fact-Kard Core en Docker — deploy/docker/.env para PROBAR EN LA LAPTOP (sin HTTPS)
#
#   cd deploy/docker && cp env.local.example .env
#   docker network create proxy_net
#   docker compose -f compose.yaml -f compose.local.yaml up -d --build
#   → http://localhost:8083
#
# Igual que producción (DEBUG=False, Gunicorn, PostgreSQL, Redis) pero sin HTTPS:
# PRODUCCION_SIN_HTTPS=True es la excepción explícita para esta prueba. No usar en el VPS.
# ======================================================================
ALLOWED_HOSTS=localhost,127.0.0.1,kardex.localhost
CORS_ALLOWED_ORIGINS=http://localhost:8083,http://kardex.localhost
CSRF_TRUSTED_ORIGINS=http://localhost:8083,http://kardex.localhost

DEBUG=False
# Cualquier clave larga sirve para la prueba local (no reutilizar en producción).
SECRET_KEY=<clave aleatoria de 50+ caracteres>
PRODUCCION_SIN_HTTPS=True
SECURE_PROXY_SSL_HEADER_HTTPS=False
NUM_PROXIES=2
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

TOKEN_MAX_AGE_SECONDS=43200
LOGIN_THROTTLE_RATE=10/min
AUTH_COOKIE_ENABLED=False
CACHE_KEY_PREFIX=fact-kard-core-local

DB_NAME=fact_kard_core
DB_USER=fact_kard_core_user
DB_PASSWORD=<contraseña de prueba larga>
DB_CONN_MAX_AGE=60

LOG_LEVEL=INFO
API_DOCS_ENABLED=False
DJANGO_ADMIN_ENABLED=False
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120

FACT_KARD_BACKUP_EXTERNAL_PATH=
FACT_KARD_BACKUP_RETENCION_DIARIOS=7
FACT_KARD_BACKUP_RETENCION_SEMANALES=4
FACT_KARD_BACKUP_RETENCION_MENSUALES=6
# FK_RESPALDO_HORA=04:00

# --- IA Multimodal (Google Gemini para lectura de facturas en Imagen/PDF) ---
# Opcional: API Key de Google Gemini. Si se omite, usa el parser regex local offline.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

