# ======================================================================
# FACT-KARD — backend/.env de PRODUCCIÓN (VPS) — ejemplo para sistema.asescon.net
#
#   cp deploy/env.produccion.example backend/.env
#   sudo chown fact-kard:fact-kard backend/.env && sudo chmod 600 backend/.env
#
# Reemplaza todo lo marcado <...>. El dominio aparece SOLO aquí y en la configuración
# de Nginx: el código no lo tiene fijo. No pongas comillas alrededor de los valores.
# Este archivo lo leen Django y Gunicorn (python-decouple); no lo cargues con `source`.
# ======================================================================

# --- Seguridad --------------------------------------------------------
DEBUG=False
# python3 -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=<clave aleatoria de 50+ caracteres>
ALLOWED_HOSTS=sistema.asescon.net
# Frontend y API en el mismo dominio (Nginx): mismo origen.
CORS_ALLOWED_ORIGINS=https://sistema.asescon.net
CSRF_TRUSTED_ORIGINS=https://sistema.asescon.net

# --- HTTPS detrás de Nginx --------------------------------------------
SECURE_PROXY_SSL_HEADER_HTTPS=True
NUM_PROXIES=1
SECURE_SSL_REDIRECT=True
# Empezar con 3600 (1 h); subir a 31536000 cuando HTTPS lleve unos días estable.
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SESSION_COOKIE_SECURE y CSRF_COOKIE_SECURE ya son True con DEBUG=False.

# --- Sesión -----------------------------------------------------------
# 12 horas (una jornada). Rechazado si supera 30 días.
TOKEN_MAX_AGE_SECONDS=43200
LOGIN_THROTTLE_RATE=10/min
# Cookie HttpOnly: lista (backend + frontend). Activar con True cuando HTTPS funcione
# (docs/DESPLIEGUE_VPS.md §Cookie HttpOnly).
AUTH_COOKIE_ENABLED=False
# Cuando se active (mismo dominio): AUTH_COOKIE_SAMESITE=Lax, AUTH_COOKIE_SECURE=True,
# AUTH_COOKIE_DOMAIN vacío (la cookie queda solo en sistema.asescon.net).

# --- Redis (caché del throttling de login) -----------------------------
CACHE_URL=redis://127.0.0.1:6379/0
CACHE_KEY_PREFIX=fact-kard

# --- PostgreSQL (solo local) ------------------------------------------
DB_NAME=fact_kard
DB_USER=fact_kard_user
DB_PASSWORD=<contraseña larga y aleatoria>
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

# --- Estáticos, logs y documentación ----------------------------------
STATIC_ROOT=/srv/fact-kard/app/backend/staticfiles
LOG_LEVEL=INFO
# Opcional: además de journald, archivo con rotación.
# LOG_FILE=/var/log/fact-kard/fact-kard.log
API_DOCS_ENABLED=False

# --- Gunicorn ---------------------------------------------------------
GUNICORN_BIND=127.0.0.1:8001
# 2 × núcleos + 1 (VPS de 2 núcleos → 5). Con poca RAM, 3.
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

# --- Bloque 17B: SUNAT (todavía sin conexión; completar en el Bloque 18) ---
# Valores reales solo en /srv/fact-kard/app/backend/.env (chmod 600), nunca en Git.
SUNAT_AMBIENTE=beta
SUNAT_USUARIO_SOL=
SUNAT_CLAVE_SOL=
# Fuera del repositorio, legible solo por el usuario del servicio (chmod 600).
SUNAT_CERTIFICADO_PATH=
SUNAT_CERTIFICADO_PASSWORD=

# ---- Bloque 24: respaldo completo (docs/RESPALDO_Y_RESTAURACION.md) ----
# Directorio local de respaldos (absoluto, fuera del código, de MEDIA_ROOT y de los artefactos).
FACT_KARD_BACKUP_DIR=/var/backups/fact-kard/completos
# Segunda copia FUERA del servidor (disco montado, NFS, carpeta sincronizada...). Vacío = SIN copia externa.
FACT_KARD_BACKUP_EXTERNAL_PATH=
FACT_KARD_BACKUP_RETENCION_DIARIOS=7
FACT_KARD_BACKUP_RETENCION_SEMANALES=4
FACT_KARD_BACKUP_RETENCION_MENSUALES=6
# Rutas de pg_dump / pg_restore si no están en el PATH (en Windows: C:\Program Files\PostgreSQL\16\bin\pg_dump.exe).
# FACT_KARD_PG_DUMP=pg_dump
# FACT_KARD_PG_RESTORE=pg_restore

# Admin de Django: sin modelos registrados; apagado en producción salvo que se necesite.
DJANGO_ADMIN_ENABLED=False
