# Fact-Kard Core — variables del entorno de DESARROLLO (docker-compose.yml de la raíz).
#   copy .env.example .env      → .env no se sube a Git.
# Para producción NO se usa este archivo: ver deploy/docker/env.produccion.example.

# Contraseña de la base de desarrollo (cualquiera larga; no reutilizar en producción).
DEV_DB_PASSWORD=
# DEV_DB_NAME=fact_kard
# DEV_DB_USER=fact_kard_user
# DEV_DB_PUERTO=5432

# Usuario demo (FK_DEMO=1 lo crea al arrancar). Contraseña obligatoria, mínimo 12 caracteres.
FK_DEMO=1
DEMO_USERNAME=admin_demo
DEMO_PASSWORD=
